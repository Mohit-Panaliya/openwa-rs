# openwa-rs environment template.
# Copy to .env and adjust. Docker Compose loads .env automatically; for a local
# run set these in the shell. Every value below is the built-in default.

# --- gateway (docs/PHASE1.md, docs/PHASE1_5.md) ---

# HTTP port. Matches OpenWA's default.
PORT=2785

# Bind address. Use 127.0.0.1 to keep the API local to the host.
HOST=0.0.0.0

# Admin API key. Leave empty and the gateway reads $DATA_DIR/.api-key, creating
# it on first boot and printing the generated key once.
API_KEY=

# Sidecar RPC timeout, milliseconds.
REQUEST_TIMEOUT_MS=15000

# tracing filter, e.g. info, debug, openwa_gateway=debug.
RUST_LOG=info

# Static dashboard directory served at / (dashboard/index.html + assets).
DASHBOARD_DIR=./dashboard

# --- state (docs/PHASE1_5.md) ---

# Base data directory: database, media blobs, engine session state, .api-key.
DATA_DIR=./data

# SQLite database file. Defaults to <DATA_DIR>/openwa.db.
# DB_PATH=./data/openwa.db

# Directory for media stored by send-media. Defaults to <DATA_DIR>/media.
# MEDIA_DIR=./data/media

# --- engine (docs/SIDECAR_PROTOCOL.md) ---

# Engine process to spawn. Defaults to the Node/Baileys sidecar:
#   <NODE_BIN> <SIDECAR_DIR>/index.js
# Set ENGINE_CMD to run the Rust engine instead, e.g.
#   ENGINE_CMD=./target/release/openwa-engine-sidecar
# ENGINE_CMD=

# Directory containing the sidecar entry point (Node engine).
SIDECAR_DIR=./sidecar

# Node executable used to launch the Node engine.
NODE_BIN=node

# Engine diagnostics level. Logging always goes to stderr, never stdout.
# Use "silent" in production.
LOG_LEVEL=silent
